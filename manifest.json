{
  "manifest_version": 3,
  "name": "Lulltab",
  "short_name": "Lulltab",
  "version": "1.3.0",
  "description": "Sleep idle tabs to free memory. They wake the moment you come back.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lulltab",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "contextMenus", "processes", "system.memory", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "sleep-tab": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Sleep the current tab"
    }
  }
}
